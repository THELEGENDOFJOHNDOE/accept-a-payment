# BLACKBOX PRO Subscription System Configuration

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Product and Price IDs (create these in Stripe Dashboard)
STRIPE_PRODUCT_ID_PRO=prod_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_PRO_YEARLY=price_...

# Database/Storage (using JSON file for simplicity)
SUBSCRIPTIONS_DB_PATH=./blackbox_pro/data/subscriptions.json
CUSTOMERS_DB_PATH=./blackbox_pro/data/customers.json

# System Configuration
BLACKBOX_PRO_ENV=development
TRIAL_PERIOD_DAYS=14
GRACE_PERIOD_DAYS=3

# Webhook Configuration
WEBHOOK_ENDPOINT_URL=http://localhost:4242/webhooks/stripe

# Feature Flags
ENABLE_TRIALS=true
ENABLE_AUTO_RENEWAL=true
ENABLE_PRORATION=true
